# ==============================================================================
# RIGHT FIT — Master Root Environment Configuration Template
# STATUS: ARCHITECTURAL TEMPLATE (No sensitive or live credentials)
# ==============================================================================

# Application Environment (development, testing, staging, production)
APP_ENV=development
APP_NAME=RIGHT_FIT
APP_DEBUG=true
PORT=8000

# Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:8000/api/v1

# Central Core PostgreSQL Database
POSTGRES_USER=rightfit_admin
POSTGRES_PASSWORD=your_secure_db_password_placeholder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rightfit_core
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# In-Memory Cache & Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_placeholder_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Service Addresses (Hybrid Modular Architecture)
LEADHUNTER_BASE_URL=http://service-leadhunter:8001
LEADHUNTER_API_KEY=internal_service_key_placeholder
STARTUP_INTELLIGENCE_BASE_URL=http://service-startup-intelligence:8002
STARTUP_INTELLIGENCE_API_KEY=internal_service_key_placeholder

# AI Gateway Configuration
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_optional_placeholder
ANTHROPIC_API_KEY=your_anthropic_api_key_optional_placeholder

# External Scraping & Data Services
SERPAPI_KEY=your_serpapi_key_placeholder
APIFY_API_TOKEN=your_apify_token_placeholder
SERPER_API_KEY=your_serper_key_placeholder
HUNTER_API_KEY=your_hunter_api_key_placeholder

# AWS Infrastructure (S3 Object Storage & Secrets)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_placeholder
S3_BUCKET_DOCUMENTS=rightfit-user-documents-placeholder

# Outbound Email & Alerting (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_placeholder
SMTP_PASSWORD=your_smtp_password_placeholder
SMTP_FROM_EMAIL=notifications@rightfit.internal

