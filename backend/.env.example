APP_ENV=development
APP_NAME="RIGHT FIT Core Engine"
PORT=8000
DEBUG=true

# Database Connection
DATABASE_URL=postgresql+asyncpg://rightfit_admin:your_secure_password@localhost:5432/rightfit_core

# Redis Broker / Cache
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your_jwt_secret_placeholder_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Inter-Service Addresses
LEADHUNTER_BASE_URL=http://localhost:8001
STARTUP_INTELLIGENCE_BASE_URL=http://localhost:8002

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_placeholder

