# ==============================================================================
# RIGHT FIT — Production Environment Configuration Template
# Parameter Store / Secrets Manager Mapping Reference
# WARNING: NEVER COMMIT ACTUAL CREDENTIALS. USE PLACEHOLDERS ONLY.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME=RIGHT_FIT
APP_DEBUG=false
PORT=8000

# Base URLs & Public Domains
FRONTEND_URL=https://rightfit.careers
BACKEND_API_URL=https://rightfit.careers/api/v1
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=https://rightfit.careers,https://www.rightfit.careers

# Production PostgreSQL Database (Amazon RDS / Managed PostgreSQL)
# Parameter Path: /rightfit/production/DATABASE_URL
# Format: postgresql+asyncpg://<username>:<password>@<rds_endpoint>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://rightfit_master:REPLACE_WITH_RDS_PASSWORD@rightfit-prod-db.cr8xxxxxxx.us-east-1.rds.amazonaws.com:5432/rightfit_core?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Production Redis (ElastiCache / Protected Redis)
# Parameter Path: /rightfit/production/REDIS_URL
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@rightfit-prod-redis.xxxxxx.0001.use1.cache.amazonaws.com:6379/0
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Security & Authentication
# Parameter Path: /rightfit/production/JWT_SECRET
JWT_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# AWS Infrastructure & Object Storage
# IAM Role Authentication preferred; no static access keys on EC2/ECS
AWS_REGION=us-east-1
S3_BUCKET_RESUMES=rightfit-resumes-prod
S3_BUCKET_REPORTS=rightfit-reports-prod
S3_BUCKET_BACKUPS=rightfit-backups-prod

# Internal Service Interconnects (Private Docker Network)
LEADHUNTER_BASE_URL=http://service-leadhunter:8001
LEADHUNTER_API_KEY=REPLACE_WITH_INTERNAL_SHARED_SECRET
STARTUP_INTELLIGENCE_BASE_URL=http://service-startup-intelligence:8002
STARTUP_INTELLIGENCE_API_KEY=REPLACE_WITH_INTERNAL_SHARED_SECRET

# AI Engine Gateway
# Parameter Path: /rightfit/production/GEMINI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_GEMINI_PRODUCTION_KEY

# Sentry & CloudWatch Observability
SENTRY_DSN=https://xxxxxxxxxxxx@o0.ingest.sentry.io/0000000
CLOUDWATCH_LOG_GROUP=/aws/rightfit/production
METRICS_PORT=9090

