{
  "$defs": {
    "ConfidenceLevel": {
      "description": "Extraction confidence classification for candidate presentation.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "EVIDENCE_UNAVAILABLE"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EvidenceDTO": {
      "description": "Supporting document evidence for an extracted field.",
      "properties": {
        "field_id": {
          "description": "Unique identifier for the evidenced field",
          "title": "Field Id",
          "type": "string"
        },
        "field_name": {
          "description": "Semantic field path, e.g. 'personal_info.phone' or 'skills.languages'",
          "title": "Field Name",
          "type": "string"
        },
        "extracted_value": {
          "description": "Original value extracted from document",
          "title": "Extracted Value"
        },
        "source_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document section containing evidence",
          "title": "Source Section"
        },
        "excerpt": {
          "description": "Exact snippet or sentence from resume supporting this fact",
          "title": "Excerpt",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page number where excerpt was located",
          "title": "Page Number"
        },
        "extraction_method": {
          "default": "STRUCTURED_PARSER",
          "description": "Method: REGEX, SECTION_PARSER, KEYWORD_MATCHER",
          "title": "Extraction Method",
          "type": "string"
        },
        "confidence_score": {
          "description": "Raw algorithmic confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "confidence_level": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "HIGH"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "PENDING"
        },
        "user_correction": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Candidate-corrected value if edited",
          "title": "User Correction"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "field_id",
        "field_name",
        "extracted_value",
        "excerpt",
        "confidence_score"
      ],
      "title": "EvidenceDTO",
      "type": "object"
    },
    "ParsingStatus": {
      "description": "Resume parsing task lifecycle states.",
      "enum": [
        "UPLOADED",
        "QUEUED",
        "PROCESSING",
        "PARSED",
        "REVIEW_REQUIRED",
        "COMPLETED",
        "FAILED",
        "DELETION_PENDING",
        "DELETED"
      ],
      "title": "ParsingStatus",
      "type": "string"
    },
    "ReviewStatus": {
      "description": "Review status for individual fields and overall extraction.",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "EDITED",
        "REJECTED",
        "IN_PROGRESS"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "description": "Structured candidate information extracted from a resume version.",
  "properties": {
    "resume_id": {
      "title": "Resume Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "parsing_status": {
      "$ref": "#/$defs/ParsingStatus"
    },
    "personal_info": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Personal Info"
    },
    "summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "education": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Education",
      "type": "array"
    },
    "experience": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Experience",
      "type": "array"
    },
    "skills": {
      "additionalProperties": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "title": "Skills",
      "type": "object"
    },
    "projects": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Projects",
      "type": "array"
    },
    "certifications": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Certifications",
      "type": "array"
    },
    "evidence_items": {
      "items": {
        "$ref": "#/$defs/EvidenceDTO"
      },
      "title": "Evidence Items",
      "type": "array"
    },
    "parsed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parsed At"
    }
  },
  "required": [
    "resume_id",
    "version_id",
    "parsing_status"
  ],
  "title": "ResumeExtractionResponse",
  "type": "object"
}