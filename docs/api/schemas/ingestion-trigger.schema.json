    },
    "records_inserted": {
      "title": "Records Inserted",
      "type": "integer"
    },
    "records_updated": {
      "title": "Records Updated",
      "type": "integer"
    },
    "duplicates_skipped": {
      "title": "Duplicates Skipped",
      "type": "integer"
    },
    "duration_seconds": {
      "title": "Duration Seconds",
      "type": "number"
    },
    "circuit_state": {
      "$ref": "#/$defs/CircuitBreakerState"
    },
    "message": {
      "title": "Message",
      "type": "string"
    }
