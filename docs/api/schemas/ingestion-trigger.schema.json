        "CLOSED",
        "OPEN",
        "HALF_OPEN"
      ],
      "title": "CircuitBreakerState",
      "type": "string"
    },
    "RunStatus": {
      "description": "Ingestion run execution outcome.",
      "enum": [
        "RUNNING",
        "SUCCESS",
        "PARTIAL_FAILURE",
        "FAILED"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "description": "Result of an ingestion run execution.",
